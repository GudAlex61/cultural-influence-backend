      },
      "request": {
        "method": "DELETE",
        "url": "http://localhost:3002/api/artwork_excerpts/22",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId=PASTE_SESSION_ID",
            "type": "text",
            "disabled": false
          }
        ]
      }
    },
    {
      "name": "07 Поставить или отменить лайк",
      "protocolProfileBehavior": {
