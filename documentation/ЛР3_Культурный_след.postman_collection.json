{
  "info": {
    "name": "Культурный след — 10 методов API",
    "description": "10 операций из задания: 7 домена отрывков и 3 домена пользователей. Первый и следующий элемент — варианты операции ленты. Для следующего у запроса 02 вручную замените URL на http://localhost:3002/api/artwork_excerpts/feed/1?next=true. URL буквальные, переменных коллекции нет. Cookie передается явным включенным заголовком; cookie jar отключен. В репозиторном экспорте замените PASTE_SESSION_ID на ID из Swagger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Список отрывков с фильтром",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "http://localhost:3002/api/artwork_excerpts?artworkCreationDate=1866-01-01",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId=PASTE_SESSION_ID",
            "type": "text",
            "disabled": false
          }
        ]
      }
    },
    {
      "name": "02 Лента отрывков",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "http://localhost:3002/api/artwork_excerpts/feed",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId=PASTE_SESSION_ID",
            "type": "text",
            "disabled": false
          }
        ]
      }
    },
    {
      "name": "03 Свой черновик",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "http://localhost:3002/api/artwork_excerpts/draft",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId=PASTE_SESSION_ID",
            "type": "text",
            "disabled": false
          }
        ]
      }
    },
    {
      "name": "04 Добавить отрывок с файлами",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "http://localhost:3002/api/artwork_excerpts",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId=PASTE_SESSION_ID",
            "type": "text",
            "disabled": false
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "artworkTitle",
              "value": "Отрывок для показа исправлений",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "C:/Users/Admin/Desktop/cultural-influence-backend/demo-media/default-artwork.jpg"
            },
            {
              "key": "video",
              "type": "file",
              "src": "C:/Users/Admin/Desktop/cultural-influence-backend/demo-media/default-artwork.mp4"
            }
          ]
        }
      }
    },
    {
      "name": "05 Опубликовать отрывок",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "PUT",
        "url": "http://localhost:3002/api/artwork_excerpts/22/publication",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Cookie",
            "value": "sessionId=PASTE_SESSION_ID",
            "type": "text",
            "disabled": false
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shortDescription\": \"Краткий отрывок произведения для показа исправлений\",\n  \"artworkCreationDate\": \"1866-01-01\",\n  \"citationCount\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Удалить свой отрывок",
      "protocolProfileBehavior": {
