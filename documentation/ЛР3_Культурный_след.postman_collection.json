{
  "info": {
    "name": "Культурный след — ЛР3 — показ",
    "description": "10 запросов в порядке показа ЛР3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "excerptId", "value": "" },
    { "key": "feedId", "value": "1" },
    { "key": "username", "value": "" }
  ],
  "item": [
    {
      "name": "01 Получить опубликованные отрывки",
      "request": { "method": "GET", "url": "{{baseUrl}}/artwork_excerpts" }
    },
    {
      "name": "02 Фильтр по дате создания произведения",
      "request": { "method": "GET", "url": "{{baseUrl}}/artwork_excerpts?artworkCreationDate=1866-01-01" }
    },
    {
      "name": "03 Создать черновик с фото и видео",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/artwork_excerpts",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "artworkTitle", "value": "Новый отрывок для ЛР3", "type": "text" },
            { "key": "image", "type": "file", "src": "C:\\Users\\Admin\\Desktop\\cultural-influence-backend\\demo-media\\default-artwork.jpg" },
            { "key": "video", "type": "file", "src": "C:\\Users\\Admin\\Desktop\\cultural-influence-backend\\demo-media\\default-artwork.mp4" }
          ]
        }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('excerptId', pm.response.json().id);"
        ] }
      }]
    },
    {
      "name": "04 Получить черновик текущего пользователя",
      "request": { "method": "GET", "url": "{{baseUrl}}/artwork_excerpts/draft" }
    },
    {
      "name": "05 Опубликовать черновик",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/artwork_excerpts/{{excerptId}}/publication",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shortDescription\": \"Тестовый отрывок для показа ЛР3\",\n  \"artworkCreationDate\": \"1900-01-01\",\n  \"citationCount\": 42\n}"
        }
      }
    },
    {
      "name": "06 Получить первую запись ленты",
      "request": { "method": "GET", "url": "{{baseUrl}}/artwork_excerpts/feed" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('200 OK', () => pm.response.to.have.status(200));",
          "pm.collectionVariables.set('feedId', pm.response.json().id);"
        ] }
      }]
    },
    {
      "name": "07 Получить следующую запись ленты",
      "request": { "method": "GET", "url": "{{baseUrl}}/artwork_excerpts/feed/{{feedId}}?next=true" }
    },
    {
      "name": "08 Поставить лайк",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/artwork_excerpts/{{excerptId}}/likes",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"liked\": 1\n}" }
      }
    },
    {
      "name": "09 Логически удалить свой отрывок",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/artwork_excerpts/{{excerptId}}" }
    },
    {
      "name": "10 Зарегистрировать пользователя",
      "event": [{
        "listen": "prerequest",
        "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('username', 'reader_lab3_' + Date.now());"
        ] }
      }],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/users",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"displayName\": \"Читатель ЛР3\",\n  \"password\": \"Lab3Password123!\"\n}"
        }
      }
    }
  ]
}
