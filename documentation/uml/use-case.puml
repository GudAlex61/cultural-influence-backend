@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor "Гость" as Guest
actor "Создатель заявки" as Requester
actor "Модератор" as Moderator

Requester --|> Guest
Moderator --|> Guest

rectangle "Культурный след" {
  package "Лабораторная работа № 1" {
    usecase "Просмотреть плитку\nотрывков" as UC_Gallery
    usecase "Отфильтровать\nпо году" as UC_Filter
    usecase "Открыть отрывок\nв ленте" as UC_Open
    usecase "Перейти к следующему\nотрывку" as UC_Next
    usecase "Просмотреть страницу\nдобавления" as UC_Draft
    usecase "Заполнить поля\nбез сохранения" as UC_Fill
  }

  package "Следующие лабораторные работы" {
    usecase "Зарегистрироваться\nи войти" as UC_Auth
    usecase "Сформировать и\nподтвердить заявку" as UC_Request
    usecase "Просмотреть свои\nзаявки" as UC_OwnRequests
    usecase "Рассчитать индекс\nI = M + 2R + 3C" as UC_Calculate
    usecase "Просмотреть все\nзаявки" as UC_AllRequests
    usecase "Изменить статус\nзаявки" as UC_Moderate
  }
}

Guest --> UC_Gallery
Guest --> UC_Open
Guest --> UC_Draft
UC_Filter ..> UC_Gallery : <<extend>>
UC_Open ..> UC_Gallery : <<extend>>
UC_Next ..> UC_Open : <<extend>>
UC_Draft ..> UC_Fill : <<include>>

Requester --> UC_Auth
Requester --> UC_Request
Requester --> UC_OwnRequests
UC_Request ..> UC_Calculate : <<include>>

Moderator --> UC_Auth
Moderator --> UC_AllRequests
Moderator --> UC_Moderate
UC_Moderate ..> UC_AllRequests : <<extend>>
@enduml

