<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="page">
  <main class="mobile-layout content-page">
    <header class="page-header">
      <a class="brand" href="/artwork-excerpts">КУЛЬТУРНЫЙ СЛЕД</a>
      <p class="eyebrow">КОЛЛЕКЦИЯ</p>
      <h1>Отрывки произведений</h1>
    </header>

    <form class="filter" action="/artwork-excerpts" method="get">
      <label class="field" for="publicationYear">
        <span>Год публикации</span>
        <input id="publicationYear" type="number" name="publicationYear" value="{{publicationYear}}" placeholder="Например, 1866">
      </label>
      <button class="button button--dark" type="submit">Найти</button>
    </form>

    <section class="gallery" aria-label="Опубликованные отрывки">
      {{#each excerpts}}
        <a class="gallery-card" href="/artwork-excerpts/feed/{{this.id}}" data-video-url="{{this.videoUrl}}">
          <div class="gallery-card__image-wrap">
            <img class="gallery-card__image" src="{{this.imageUrl}}" alt="Обложка произведения {{this.workTitle}}">
          </div>
          <div class="gallery-card__body">
            <h2>{{this.workTitle}}</h2>
            <div class="gallery-card__meta">
              <span>{{this.publicationYear}}</span>
              <span>♥ {{this.likeCount}}</span>
            </div>
          </div>
        </a>
      {{else}}
        <p class="empty-state">За этот год опубликованных отрывков нет.</p>
      {{/each}}
    </section>
  </main>
  {{> bottom_navigation}}
</body>
</html>
