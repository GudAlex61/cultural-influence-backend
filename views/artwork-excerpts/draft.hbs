<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="page">
  <main class="mobile-layout content-page">
    <header class="page-header">
      <a class="brand" href="/artwork-excerpts">КУЛЬТУРНЫЙ СЛЕД</a>
      <p class="eyebrow">НОВЫЙ МАТЕРИАЛ</p>
      <h1>Добавление отрывка</h1>
    </header>

    <form class="draft-card">
      <img class="draft-card__image" src="{{excerpt.imageUrl}}" alt="Обложка произведения {{excerpt.workTitle}}">
      <video class="draft-card__video" controls muted poster="{{excerpt.imageUrl}}">
        <source src="{{excerpt.videoUrl}}" type="video/mp4">
        Ваш браузер не поддерживает видео.
      </video>

      <label class="field">
        <span>Ключ изображения в MinIO</span>
        <input type="text" name="imageObjectKey" value="{{excerpt.imageObjectKey}}">
      </label>

      <label class="field">
        <span>Ключ видео в MinIO</span>
        <input type="text" name="videoObjectKey" value="{{excerpt.videoObjectKey}}">
      </label>

      <label class="field">
        <span>Название произведения</span>
        <input type="text" name="workTitle" value="{{excerpt.workTitle}}">
      </label>

      <label class="field">
        <span>Автор</span>
        <input type="text" name="creatorName" value="{{excerpt.creatorName}}">
      </label>

      <div class="field-row">
        <label class="field">
          <span>Вид произведения</span>
          <input type="text" name="workType" value="{{excerpt.workType}}">
        </label>
        <label class="field">
          <span>Год публикации</span>
          <input type="number" name="publicationYear" value="{{excerpt.publicationYear}}">
        </label>
      </div>

      <label class="field">
        <span>Текст отрывка</span>
        <textarea name="excerptText" rows="6">{{excerpt.excerptText}}</textarea>
      </label>
    </form>
  </main>
  {{> bottom_navigation}}
</body>
</html>
