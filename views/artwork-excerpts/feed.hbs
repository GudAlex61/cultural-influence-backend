<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="page page--dark">
  <main class="mobile-layout feed-page">
    <header class="compact-header compact-header--overlay">
      <a class="brand brand--light" href="/artwork-excerpts">КУЛЬТУРНЫЙ СЛЕД</a>
      <span class="section-label">ОТРЫВКИ</span>
    </header>

    <section class="feed-scroll" aria-label="Лента отрывков">
      {{#each excerpts}}
        <article class="feed-card" id="excerpt-{{this.id}}">
          <video class="feed-card__video" poster="{{this.imageUrl}}" autoplay muted loop playsinline preload="metadata">
            <source src="{{this.videoUrl}}" type="video/mp4">
            Ваш браузер не поддерживает видео.
          </video>
          <div class="feed-card__shade"></div>

          <div class="feed-card__content">
            <img class="feed-card__cover" src="{{this.imageUrl}}" alt="Обложка произведения {{this.workTitle}}">
            <p class="eyebrow">{{this.workType}} · {{this.publicationYear}}</p>
            <h1>{{this.workTitle}}</h1>
            <p class="feed-card__creator">{{this.creatorName}}</p>

            <details class="excerpt-details">
              <summary>
                <span class="details-more">Больше</span>
                <span class="details-less">Меньше</span>
              </summary>
              <p>{{this.excerptText}}</p>
            </details>

            <div class="feed-card__actions">
              <span class="like-counter" aria-label="Количество отметок нравится">♥ {{this.likeCount}}</span>
            </div>
            <p class="swipe-hint" aria-hidden="true">↑ Проведите вверх</p>
          </div>
        </article>
      {{/each}}
    </section>
  </main>
  {{> bottom_navigation}}
</body>
</html>
